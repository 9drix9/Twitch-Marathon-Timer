# ── Admin ────────────────────────────────────────────
# Secret token used to access the admin panel and API.
# Pick something long and random.  e.g.  openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-random-string

# ── Upstash Redis ────────────────────────────────────
# Create a free database at https://console.upstash.com
# Or add the Upstash integration in your Vercel dashboard
# (Settings → Integrations → Upstash) to auto-populate these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Timer defaults ───────────────────────────────────
# Starting timer value in seconds (default: 24 hours)
TIMER_START_SECONDS=86400

# ── Twitch ───────────────────────────────────────────
# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_WEBHOOK_SECRET=

# ── StreamElements (optional) ────────────────────────
STREAMELEMENTS_WEBHOOK_SECRET=

# ── Streamlabs (optional) ───────────────────────────
STREAMLABS_WEBHOOK_SECRET=
